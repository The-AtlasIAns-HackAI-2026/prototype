# Backend
APP_ENV=production
# These public domain and agent identifiers are legacy infrastructure names.
# Keep them until Twilio, LiveKit, DNS, and Vercel are renamed.
PUBLIC_BASE_URL=https://moulcyber.duckdns.org
CORS_ALLOW_ORIGINS=https://moulcyber.vercel.app,http://localhost:5173
CORS_ALLOW_ORIGIN_REGEX=https://.*\.vercel\.app

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
CUSTOM_LLM_API_KEY=
LLM_FALLBACK_ON_ERROR=true

# Voice provider
VOICE_PROVIDER=livekit

# LiveKit + Gemini Live main call path
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=moulcyber-live-agent
LIVEKIT_AGENT_PORT=8081
LIVEKIT_SIP_URI=sip:0c0g2hzfv6c.sip.livekit.cloud;transport=tcp
HOTLINE_API_BASE_URL=http://backend:8000
HOTLINE_API_TIMEOUT=8
HOTLINE_EXPERTS_FILE=/app/config/hotline/experts.json
MOCK_CHIKAYA_LOG_FILE=/app/logs/mock_chikaya_submissions.jsonl
ORAL_APPROVAL_LOG_FILE=/app/logs/oral_approvals.jsonl
LEGAL_RAG_DIR=/app/rag_datasets
GOOGLE_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_VOICE=Puck
GEMINI_LIVE_TEMPERATURE=0.35
GEMINI_THINKING_LEVEL=minimal
GEMINI_ENABLE_GOOGLE_SEARCH=true
MCP_ENABLED=true
MCP_SERVERS_FILE=/app/config/mcp.servers.json

# ElevenLabs ConvAI
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_PHONE_NUMBER_ID=

# Twilio
TWILIO_PHONE_NUMBER=+17754060061
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_TRUNK_SID=TKc8fff9e36f81493855785cd5be5faff8
TWILIO_TERMINATION_URI=moulcyber-livekit.pstn.twilio.com
TWILIO_VALIDATE_SIGNATURE=false

# Logging
LOG_FILE=/app/logs/events.jsonl
